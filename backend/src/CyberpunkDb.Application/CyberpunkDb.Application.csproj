<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CyberpunkDb.Domain\CyberpunkDb.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Npcs\Rules\npc-rules.json" LogicalName="CyberpunkDb.Application.Npcs.Rules.npc-rules.json" />
    <EmbeddedResource Include="Characters\Rules\character-rules.json" LogicalName="CyberpunkDb.Application.Characters.Rules.character-rules.json" />
    <EmbeddedResource Include="NightMarkets\Rules\night-market-rules.json" LogicalName="CyberpunkDb.Application.NightMarkets.Rules.night-market-rules.json" />
    <!-- extracted from the PDFs by tools/night-market/extract.mjs -->
    <EmbeddedResource Include="..\..\..\data\source\night-market-index.json" LogicalName="CyberpunkDb.Application.NightMarkets.night-market-index.json" />
    <EmbeddedResource Include="..\..\..\data\source\black-chrome-booths.json" LogicalName="CyberpunkDb.Application.NightMarkets.black-chrome-booths.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
